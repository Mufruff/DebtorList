<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Debtorslist1.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="500"
             x:Class="Debtorslist1.Views.DebtorView"
             x:DataType="vm:DebtorViewViewModel">

    <Grid ColumnDefinitions="300,*" Margin="15">

        <!-- ЛЕВАЯ КОЛОНКА -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

            <TextBlock Grid.Row="0"
                       Text="Список должников"
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Debtors}"
                     SelectedItem="{Binding SelectedDebtor}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FullName}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2"
                    Content="Обновить список"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,10,0,0"/>
        </Grid>

        <!-- ПРАВАЯ КОЛОНКА -->
        <ScrollViewer Grid.Column="1" Margin="20,0,0,0">
            <StackPanel Spacing="10" MaxWidth="500" HorizontalAlignment="Left">

                <TextBlock Text="Редактирование должника" FontSize="18"/>

                <TextBlock Text="ФИО"/>
                <TextBox Text="{Binding SelectedDebtor.FullName}"/>

               <TextBlock Text="Начальная сумма (руб.)" Foreground="Gray"/>
<TextBlock Text="{Binding SelectedDebtor.OriginalDebt, StringFormat='{}{0:N2}'}"
           FontSize="14"/>

<TextBlock Text="Текущий долг (руб.)"/>
<TextBox Text="{Binding SelectedDebtor.CurrentDebt}"/>

                <TextBlock Text="Процентная ставка (% в месяц)"/>
                <TextBox Text="{Binding SelectedDebtor.InterestRate}"/>

                <TextBlock Text="Дата выдачи"/>
                <DatePicker SelectedDate="{Binding SelectedDateIssued}"/>

                <TextBlock Text="Срок возврата"/>
                <DatePicker SelectedDate="{Binding SelectedDueDate}"/>

                <TextBlock Text="Заметки"/>
                <TextBox Text="{Binding SelectedDebtor.Notes}"
                         AcceptsReturn="True"
                         Height="70"
                         TextWrapping="Wrap"/>

                <CheckBox Content="Отметить к удалению"
          IsChecked="{Binding SelectedDebtor.MarkedForDeletion}"
          Margin="0,5,0,0"/>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                    <Button Content="Сохранить"
                            Command="{Binding SaveCommand}"
                            Width="120"/>
                    <Button Content="Начислить %"
                            Command="{Binding AccrueInterestCommand}"
                            Width="120"/>
                    <Button Content="Удалить"
                            Command="{Binding DeleteCommand}"
                            Width="120"
                            IsEnabled="{Binding SelectedDebtor.MarkedForDeletion}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Green"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>