<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Debtorslist1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Debtorslist1.Views"
        mc:Ignorable="d"
        d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Debtorslist1.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Список должников"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">


    <TabControl>
        <TabItem Header="Создать должника">
             <views:CreateDebtorView DataContext="{Binding CreateDebtorVm}"/>
        </TabItem>

        <TabItem Header="Просмотр должника">
    <views:DebtorView DataContext="{Binding DebtorViewVm}"/>
</TabItem>

      <TabItem Header="История">
    <views:HistoryView DataContext="{Binding HistoryVm}"/>
</TabItem>
    </TabControl>
</Window>